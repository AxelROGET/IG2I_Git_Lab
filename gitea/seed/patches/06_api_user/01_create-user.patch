From: Emeline <emeline@example.fr>
Date: Sat, 28 Feb 2026 12:02:11 +0000
Subject: [PATCH] create user

---
 app.py | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/app.py b/app.py
index 3489686..d48162b 100755
--- a/app.py
+++ b/app.py
@@ -62,7 +62,29 @@ def login():
 @app.route('/api/users', methods=['POST'])
 @jwt_required()
 def create_user():
-    return True
+    claims = get_jwt()
+    if not claims.get("is_admin"):
+        return jsonify({"msg": "Admin requis"}), 403
+
+    data = request.get_json()
+    hashed_pw = bcrypt.hashpw(data['password'].encode('utf-8'), bcrypt.gensalt()).decode('utf-8')
+    
+    conn = get_db_connection()
+    cur = conn.cursor()
+    try:
+        cur.execute(
+            "INSERT INTO users (username, password, is_admin, balance) VALUES (%s, %s, %s, %s) RETURNING id",
+            (data['username'], hashed_pw, data.get('admin', False), data.get('montant', 0))
+        )
+        new_id = cur.fetchone()['id']
+        conn.commit()
+        return jsonify({"id": new_id}), 201
+    except Exception as e:
+        conn.rollback()
+        return jsonify({"error": str(e)}), 400
+    finally:
+        cur.close()
+        conn.close()
 
 @app.route('/api/transactions', methods=['POST'])
 @jwt_required()
