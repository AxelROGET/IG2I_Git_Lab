Subject: [PATCH] Get transactions from a certain author

---
 app.py | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/app.py b/app.py
index 3489686..515e4d0 100755
--- a/app.py
+++ b/app.py
@@ -72,7 +72,16 @@ def post_transaction():
 @app.route('/api/transactions/author/<int:user_id>', methods=['GET'])
 @jwt_required()
 def get_author_transactions(user_id):
-    return True
+    if int(get_jwt_identity()) != user_id and not get_jwt().get("is_admin"):
+        return jsonify({"msg": "Non autorisé"}), 403
+
+    conn = get_db_connection()
+    cur = conn.cursor()
+    cur.execute("SELECT * FROM transactions WHERE author_id = %s", (user_id,))
+    rows = cur.fetchall()
+    cur.close()
+    conn.close()
+    return jsonify(rows), 200
 
 @app.route('/api/transactions/beneficiary/<int:user_id>', methods=['GET'])
 @jwt_required()
