@@ -0,0 +1,65 @@
+import os
+from dotenv import load_dotenv
+from datetime import timedelta
+from flask import Flask, request, jsonify
+from flask_jwt_extended import JWTManager, create_access_token, jwt_required, get_jwt_identity, get_jwt
+import psycopg2
+from psycopg2.extras import RealDictCursor
+import bcrypt
+
+load_dotenv()
+
+app = Flask(__name__)
+
+# Configuration
+app.config["JWT_SECRET_KEY"] = os.getenv("JWT_SECRET_KEY", "secret-key")
+app.config["JWT_ACCESS_TOKEN_EXPIRES"] = timedelta(hours=24)
+jwt = JWTManager(app)
+
+print(f"HOST : {os.getenv("POSTGRES_HOST")}, DB : {os.getenv("POSTGRES_DB")}, USER : {os.getenv("POSTGRES_USER")}, PASSWORD : {os.getenv("POSTGRES_PASSWORD")}")
+
+# Connexion DB
+def get_db_connection():
+    return psycopg2.connect(
+        host=os.getenv("POSTGRES_HOST"), 
+        database=os.getenv("POSTGRES_DB"),
+        user=os.getenv("POSTGRES_USER"),
+        password=os.getenv("POSTGRES_PASSWORD"),
+        cursor_factory=RealDictCursor
+    )
+
+# --- ROUTES ---
+
+# --- ADMIN ENDPOINT WITHOUT BEING LOGGED IN (DEV) ---
+@app.route('/api/dev/users', methods=['POST'])
+def dev_create_user():
+    return True
+
+# --- PROD ENDPOINTS ---
+
+@app.route('/api/login', methods=['POST'])
+def login():
+    return True
+
+@app.route('/api/users', methods=['POST'])
+@jwt_required()
+def create_user():
+    return True
+
+@app.route('/api/transactions', methods=['POST'])
+@jwt_required()
+def post_transaction():
+    return True
+
+@app.route('/api/transactions/author/<int:user_id>', methods=['GET'])
+@jwt_required()
+def get_author_transactions(user_id):
+    return True
+
+@app.route('/api/transactions/beneficiary/<int:user_id>', methods=['GET'])
+@jwt_required()
+def get_beneficiary_transactions(user_id):
+    return True
+
+if __name__ == '__main__':
+    app.run(host='0.0.0.0', port=5000)
\ No newline at end of file
